{
  "topic": {
    "id": "linked-list",
    "title": "Become Master in Linked List",
    "category": "Data Structures",
    "description": "A structured study guide covering linked-list fundamentals, pointer techniques, operations, and progressively harder problem-solving patterns.",
    "difficulty": "beginner-to-advanced"
  },

  "learning_goals": [
    "Understand how linked lists store data",
    "Implement singly, doubly and circular linked lists",
    "Master insertion and deletion",
    "Master pointer manipulation",
    "Recognize fast-slow pointer patterns",
    "Recognize reversal patterns",
    "Solve linked-list problems from easy to hard",
    "Understand how linked lists are used in LRU and LFU caches"
  ],

  "prerequisites": [
    "References / pointers",
    "Classes / structures",
    "Loops",
    "Recursion basics",
    "Time and space complexity"
  ],

  "core_concepts": {
    "what_is_linked_list": {
      "title": "What is a Linked List?",
      "definition": "A linked list is a linear data structure consisting of nodes connected through references or pointers.",
      "node_structure": {
        "singly": {
          "data": "value stored in the node",
          "next": "reference to the next node"
        },
        "doubly": {
          "data": "value stored in the node",
          "prev": "reference to previous node",
          "next": "reference to next node"
        }
      },
      "visual": "HEAD -> [10|next] -> [20|next] -> [30|null]"
    },

    "array_vs_linked_list": {
      "comparison": [
        {
          "feature": "Memory allocation",
          "array": "Usually contiguous",
          "linked_list": "Nodes can be non-contiguous"
        },
        {
          "feature": "Size",
          "array": "Fixed for basic arrays",
          "linked_list": "Dynamic"
        },
        {
          "feature": "Random access",
          "array": "O(1)",
          "linked_list": "O(n)"
        },
        {
          "feature": "Search",
          "array": "O(n) unsorted",
          "linked_list": "O(n)"
        },
        {
          "feature": "Insertion",
          "array": "O(n) in general",
          "linked_list": "O(1) when insertion position/node reference is already known"
        },
        {
          "feature": "Deletion",
          "array": "O(n) in general",
          "linked_list": "O(1) when node/previous reference is already known"
        }
      ]
    }
  },

  "types": [
    {
      "id": "singly",
      "name": "Singly Linked List",
      "description": "Each node points to the next node.",
      "visual": "HEAD -> A -> B -> C -> null"
    },
    {
      "id": "doubly",
      "name": "Doubly Linked List",
      "description": "Each node points to both previous and next nodes.",
      "visual": "null <- A <-> B <-> C -> null"
    },
    {
      "id": "circular",
      "name": "Circular Linked List",
      "description": "The last node points back to the first node.",
      "visual": "A -> B -> C -> A"
    },
    {
      "id": "circular_doubly",
      "name": "Circular Doubly Linked List",
      "description": "Each node has previous and next references and the ends are connected.",
      "visual": "A <-> B <-> C <-> A"
    }
  ],

  "complexity": {
    "singly_linked_list": {
      "access": "O(n)",
      "search": "O(n)",
      "insert_at_known_position": "O(1)",
      "delete_at_known_position": "O(1)"
    },
    "note": "Finding the position/node itself may require O(n)."
  },

  "basic_operations": [
    {
      "id": "create",
      "title": "Create Linked List",
      "goal": "Create nodes and connect them.",
      "pattern": [
        "Create node",
        "Store value",
        "Connect previous node to new node",
        "Update tail"
      ],
      "visual": "HEAD -> 10 -> 20 -> 30 -> null"
    },
    {
      "id": "traverse",
      "title": "Traverse Linked List",
      "goal": "Visit every node.",
      "template": "curr = head; while (curr != null) { process(curr); curr = curr.next; }",
      "complexity": "O(n)"
    },
    {
      "id": "insert",
      "title": "Insert Node",
      "key_rule": "Never lose the reference to the remaining list.",
      "steps": [
        "Find insertion location",
        "Save required references",
        "Connect new node",
        "Reconnect remaining list"
      ]
    },
    {
      "id": "delete",
      "title": "Delete Node",
      "key_rule": "Reconnect the previous node to the node after the deleted node.",
      "steps": [
        "Find node or previous node",
        "Save next reference if required",
        "Change pointer/reference",
        "Remove node"
      ]
    }
  ],

  "pointer_patterns": [
    {
      "id": "prev_curr_next",
      "name": "Previous / Current / Next",
      "used_for": [
        "Reverse Linked List",
        "Reversing a portion",
        "Rearranging links"
      ],
      "variables": [
        "prev",
        "curr",
        "next"
      ],
      "mental_model": "Before changing curr.next, save the original next node."
    },
    {
      "id": "fast_slow",
      "name": "Fast and Slow Pointers",
      "used_for": [
        "Finding middle",
        "Detecting cycles",
        "Finding cycle entry",
        "Palindrome Linked List",
        "Finding relative positions"
      ],
      "movement": {
        "slow": "1 step",
        "fast": "2 steps"
      }
    },
    {
      "id": "two_pointer_gap",
      "name": "Two Pointers with Gap",
      "used_for": [
        "Remove Nth Node From End",
        "Finding kth node from end"
      ],
      "idea": "Keep a fixed distance between two pointers."
    },
    {
      "id": "pointer_switching",
      "name": "Pointer Switching",
      "used_for": [
        "Intersection of Two Linked Lists"
      ],
      "idea": "Pointer A traverses A then B. Pointer B traverses B then A.",
      "reason": "Both pointers travel the same total distance."
    }
  ],

  "patterns": [
    {
      "id": "pattern-01",
      "title": "Reverse Linked List",
      "difficulty": "easy",
      "recognition": [
        "Reverse the entire list",
        "Reverse a portion",
        "Reverse nodes in groups"
      ],
      "core_idea": "Reverse each next pointer while maintaining references to previous and next nodes.",
      "template": "prev = null; curr = head; while (curr != null) { next = curr.next; curr.next = prev; prev = curr; curr = next; } return prev;",
      "key_variables": [
        "prev",
        "curr",
        "next"
      ],
      "complexity": {
        "time": "O(n)",
        "space": "O(1)"
      },
      "practice": [
        {
          "id": 206,
          "title": "Reverse Linked List",
          "url": "https://leetcode.com/problems/reverse-linked-list/"
        },
        {
          "id": 92,
          "title": "Reverse Linked List II",
          "url": "https://leetcode.com/problems/reverse-linked-list-ii/"
        },
        {
          "id": 25,
          "title": "Reverse Nodes in k-Group",
          "url": "https://leetcode.com/problems/reverse-nodes-in-k-group/"
        }
      ]
    },

    {
      "id": "pattern-02",
      "title": "Fast and Slow Pointer",
      "difficulty": "easy-to-medium",
      "recognition": [
        "Middle of linked list",
        "Cycle detection",
        "Palindrome",
        "Distance between nodes"
      ],
      "template": "slow = head; fast = head; while (fast != null && fast.next != null) { slow = slow.next; fast = fast.next.next; }",
      "complexity": {
        "time": "O(n)",
        "space": "O(1)"
      },
      "practice": [
        {
          "id": 876,
          "title": "Middle of the Linked List",
          "url": "https://leetcode.com/problems/middle-of-the-linked-list/"
        },
        {
