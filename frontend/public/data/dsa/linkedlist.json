  "common_mistakes": [
    {
      "mistake": "Changing curr.next before saving the original next node",
      "fix": "Store next = curr.next first."
    },
    {
      "mistake": "Losing the head reference",
      "fix": "Keep a stable head/dummy reference when modifying the list."
    },
    {
      "mistake": "Forgetting null checks",
      "fix": "Check head, head.next, fast and fast.next where appropriate."
    },
    {
      "mistake": "Incorrectly updating doubly linked-list pointers",
      "fix": "Whenever changing one side, verify both prev and next connections."
    },
    {
      "mistake": "Creating unnecessary special cases for head operations",
      "fix": "Use a dummy node."
    },
    {
      "mistake": "Confusing node value with node reference",
      "fix": "Compare nodes using references when the problem asks for the actual intersection/cycle node."
    }
  ],

  "master_rules": [
    {
      "rule": 1,
      "title": "Never Lose Your Reference",
      "description": "Before breaking a link, save the node you still need."
    },
    {
      "rule": 2,
      "title": "Draw the Pointers",
      "description": "For difficult linked-list problems, draw nodes and arrows before coding."
    },
    {
      "rule": 3,
      "title": "Know Your Pointer Movement",
      "description": "Ask whether a pointer moves one step, two steps, or maintains a fixed gap."
    },
    {
      "rule": 4,
      "title": "Use Dummy Nodes",
      "description": "Dummy nodes simplify operations involving the head."
    },
    {
      "rule": 5,
      "title": "Protect the Remaining List",
      "description": "Whenever changing links, make sure the rest of the list remains reachable."
    }
  ],

