    {
      "id": "pattern-04",
      "title": "Intersection of Two Linked Lists",
      "difficulty": "medium",
      "recognition": [
        "Two lists may merge",
        "Need first common node",
        "Different list lengths"
      ],
      "core_idea": "Traverse list A then B and list B then A.",
      "template": "a = headA; b = headB; while (a != b) { a = a == null ? headB : a.next; b = b == null ? headA : b.next; } return a;",
      "complexity": {
        "time": "O(n + m)",
        "space": "O(1)"
      },
      "practice": [
        {
          "id": 160,
