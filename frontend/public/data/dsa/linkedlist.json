          "url": "https://leetcode.com/problems/palindrome-linked-list/"
        }
      ]
    },

    {
      "id": "pattern-03",
      "title": "Two Pointers with Gap",
      "difficulty": "medium",
      "recognition": [
        "Nth node from end",
        "Kth node from end",
        "Maintain fixed distance"
      ],
      "template": "Move fast k steps ahead, then move fast and slow together until fast reaches the required boundary.",
      "practice": [
        {
          "id": 19,
          "title": "Remove Nth Node From End of List",
          "url": "https://leetcode.com/problems/remove-nth-node-from-end-of-list/"
