          }
        },

        {
          "id": "clear-bit",
          "title": "Clear i-th Bit",
          "formula": "n &= ~(1 << i)",

          "code": {
            "language": "cpp",
            "value": "n &= ~(1 << i);"
          }
        },

        {
          "id": "toggle-bit",
          "title": "Toggle i-th Bit",
          "formula": "n ^= (1 << i)",

          "code": {
            "language": "cpp",
            "value": "n ^= (1 << i);"
          }
        },

        {
          "id": "count-set-bits",
          "title": "Count Set Bits",
          "difficulty": "easy",

          "methods": [

            {
              "name": "bit-by-bit",
              "formula": "count += (n >> i) & 1",
              "complexity": "O(B)"
            },

            {
              "name": "brian-kernighan",
              "formula": "n = n & (n - 1)",
              "idea": "Every iteration removes the lowest set bit.",
              "complexity": "O(K)",
              "where": "K = number of set bits"
            }
          ],

          "code": {
            "language": "cpp",
            "value": "int countSetBits(int n) {\n    int count = 0;\n    while (n) {\n        n &= (n - 1);\n        count++;\n    }\n    return count;\n}"
          }
        },

