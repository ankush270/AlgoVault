    {
      "id": "gray-code",
      "title": "10. Gray Code",
      "type": "pattern",

      "definition": "Gray code is an ordering where consecutive values differ in exactly one bit.",

      "binary_to_gray": {
        "formula": "gray = n ^ (n >> 1)",

        "code": {
          "language": "cpp",
          "value": "vector<int> grayCode(int n) {\n    vector<int> ans;\n    for (int i = 0; i < (1 << n); ++i) {\n        ans.push_back(i ^ (i >> 1));\n    }\n    return ans;\n}"
        }
      },

      "gray_to_binary": {
        "formula": "binary = cumulative XOR of Gray bits",

        "code": {
          "language": "cpp",
          "value": "int grayToBinary(int g) {\n    int n = 0;\n    while (g) {\n        n ^= g;\n        g >>= 1;\n    }\n    return n;\n}"
        }
      },

      "problems": [
