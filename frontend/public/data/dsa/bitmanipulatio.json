      "id": "xor-patterns",
      "title": "6. XOR Patterns",
      "type": "pattern_collection",

      "properties": [
        {
          "formula": "x ^ x = 0",
          "meaning": "A value cancels itself."
        },
        {
          "formula": "x ^ 0 = x",
          "meaning": "XOR with zero preserves the value."
        },
        {
          "formula": "a ^ b = b ^ a",
          "meaning": "XOR is commutative."
        },
        {
          "formula": "(a ^ b) ^ c = a ^ (b ^ c)",
          "meaning": "XOR is associative."
        },
        {
          "formula": "a ^ b = c  =>  a = b ^ c",
          "meaning": "XOR can recover an unknown operand."
        }
      ],

