          "formula": "a + b = (a ^ b) + 2 × (a & b)",
          "meaning": "XOR gives addition without carry; AND identifies carry positions."
        },

        {
          "formula": "a | b = (a ^ b) + (a & b)",
          "meaning": "Useful because XOR and AND partition the set bits."
        },

        {
          "formula": "a ^ b = (a | b) - (a & b)",
          "meaning": "Equivalent relationship among OR, XOR and AND."
        }
      ],

