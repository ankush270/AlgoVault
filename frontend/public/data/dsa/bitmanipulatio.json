    {
      "id": "meet-in-the-middle",
      "title": "13. Meet in the Middle + Bitmask",
      "type": "advanced_pattern",

      "idea": "Split an array into two halves, enumerate subsets independently, then combine compatible results.",

      "why": "It reduces 2^N enumeration into roughly 2^(N/2) on each side.",

      "steps": [
        "Split array into left and right halves.",
        "Generate all subsets of the left half.",
        "Generate all subsets of the right half.",
        "Group subsets by selected-element count when required.",
        "Sort candidate sums.",
        "For each left sum, binary-search the best compatible right sum."
      ],

      "complexity": {
        "subset_generation": "O(2^(N/2))",
        "memory": "O(2^(N/2))"
      },

      "problem": {
        "title": "Partition Array Into Two Arrays to Minimize Sum Difference",
        "url": "https://leetcode.com/problems/partition-array-into-two-arrays-to-minimize-sum-difference/"
      },

      "template": {
        "language": "cpp",
        "code": "vector<vector<int>> generate(\n    vector<int>& nums,\n    int l,\n    int r\n) {\n    int n = r - l + 1;\n    vector<vector<int>> res(n + 1);\n\n    for (int mask = 0; mask < (1 << n); ++mask) {\n        int sum = 0;\n        int cnt = 0;\n\n        for (int i = 0; i < n; ++i) {\n            if (mask & (1 << i)) {\n                sum += nums[l + i];\n                cnt++;\n            }\n        }\n\n        res[cnt].push_back(sum);\n    }\n\n    return res;\n}"
      }
    },

