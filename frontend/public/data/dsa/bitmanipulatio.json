    {
      "id": "subset-dp",
      "title": "12. DP + Bitmask",
      "type": "advanced_pattern",

      "definition": "Represent a subset of n elements as an integer from 0 to 2^n - 1.",

      "state": {
        "mask": "Which elements have already been selected.",
        "bit_i": "1 means element i is selected.",
        "bit_i_zero": "0 means element i is not selected."
      },

      "example": {
        "array": ["A","B","C","D"],
        "mask": "0101",
        "selected": ["A","C"]
      },

      "state_count": "2^n",

      "template": {
        "language": "cpp",
        "code": "int dfs(int idx, int mask) {\n    if (idx == n) return 0;\n\n    if (dp[idx][mask] != -1)\n        return dp[idx][mask];\n\n    int ans = INF;\n\n    for (int i = 0; i < n; ++i) {\n        if (mask & (1 << i))\n            continue;\n\n        int newMask = mask | (1 << i);\n\n        ans = min(ans,\n            cost(idx, i) + dfs(idx + 1, newMask));\n    }\n\n    return dp[idx][mask] = ans;\n}"
      },

      "complexity": {
        "states": "O(n × 2^n)",
        "transitions_per_state": "O(n)",
        "typical_total": "O(n² × 2^n)"
      },

      "when_to_use": [
        "n is small",
        "problem asks about subsets",
        "used/unused state matters",
        "permutations are too expensive",
        "constraints are around n <= 20 or similar"
      ],

